# Database
DATABASE_URL="postgresql://username:password@localhost:5432/bloxmedical"
# Hosted Postgres often requires TLS: append ?sslmode=require (or no-verify) to DATABASE_URL for Prisma and other tools.

# NextAuth
# For production, set this to your production URL (e.g., https://yourdomain.com)
# This is REQUIRED to prevent infinite redirect loops in production
NEXTAUTH_URL="http://localhost:3000"
# NextAuth v5 uses AUTH_SECRET instead of NEXTAUTH_SECRET
AUTH_SECRET="your-secret-key-here"
# Legacy support (if needed)
NEXTAUTH_SECRET="your-secret-key-here"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# AWS S3 Configuration
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
NEXT_PUBLIC_AI_SERVICE_URL="http://ec2-13-51-44-218.eu-north-1.compute.amazonaws.com"